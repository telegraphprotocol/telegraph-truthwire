PORT=5000
DATABASE_URL="mongodb://localhost:27017/sniper_bot?directConnection=true"

# Telegraph WebSocket signal subscription
TELEGRAPH_WS_URL="ws://13.237.89.59:7044/engine/ws"
# Service-level EVM wallet used to authenticate the WS connection.
# Must hold >= 1.00 USDC deposited in the Telegraph escrow contract before connecting.
SERVICE_WALLET_PRIVATE_KEY="0xYourServiceWalletPrivateKey"
SIGNAL_INTENTS="LANGUAGE_GENERATION,CHAT_COMPLETION,TEXT_GENERATION,HIGH_PERFORMANCE_INFERENCE,EMBEDDINGS,CONTENT_MODERATION,WEATHER_CHECK,STORM_ALERT,WEATHER_FORECAST,WEATHER_RISK_ASSESSMENT,MULTIMODAL_INFERENCE,IMAGE_GENERATION,TEXT_TO_IMAGE,TASK_COMPLETION,AGENT_TASK,WEB_SEARCH,TWITTER_SEARCH,NEWS_SEARCH,RESEARCH_SYNTHESIS,FACT_CHECK,TEXT_AUTHENTICITY_CHECK,AI_TEXT_DETECTION,CONTENT_VERIFICATION,DEEPFAKE_DETECTION,MEDIA_AUTHENTICITY_CHECK,IMAGE_VERIFICATION,VIDEO_VERIFICATION"

# Simulated trading / portfolio
SIM_STARTING_BALANCE_USD=1000
SIM_MAX_STAKE_USD=10
SIM_MIN_SHARES=10
SIM_HOLD_HOURS=6

# Polymarket market search
MARKET_FETCH_LIMIT=3
MARKET_FETCH_CANDIDATE_LIMIT=30

# LLM used for market matching + trade decisions. Points at a LiteLLM gateway
# running on localhost on the deployed server (same pattern as tg-terminal-backend's
# build.service.ts) — there is nothing listening on this port locally, so this
# only resolves once deployed alongside the gateway.
LITELLM_BASE_URL="http://localhost:4000/v1"
LITELLM_API_KEY=""
LITELLM_MODEL="nova-2-lite"
