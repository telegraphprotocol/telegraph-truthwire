datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Signal {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  telegraphId       String          @unique
  intent            String
  category          String?
  questionText      String
  routingSubnet     String?
  rawPayload        Json
  matchedMarketSlug  String?
  matchedMarketTitle String?
  matchedYesPrice    String?
  matchedNoPrice     String?
  matchedMarketUrl   String?
  decisionAction     String?
  likelihood         Float?
  trades             SimulatedTrade[]
  createdAt          DateTime        @default(now())

  @@index([createdAt])
  @@index([intent, createdAt])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  open
  closed
}

model SimulatedTrade {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  signalId      String      @db.ObjectId
  signal        Signal      @relation(fields: [signalId], references: [id])
  marketSlug    String
  marketTitle   String
  side          TradeSide
  entryPrice    Float
  exitPrice     Float?
  stake         Float
  pnl           Float?
  status        TradeStatus @default(open)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?

  @@index([status])
  @@index([marketSlug, status])
  @@index([openedAt])
}

model PortfolioState {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  singleton   String   @unique @default("global")
  balance     Float
  totalPnl    Float    @default(0)
  updatedAt   DateTime @updatedAt
}
